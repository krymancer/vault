# Vault connection
VAULT_ADDR=http://localhost:5045
VAULT_APP_ID=your_credential_id
VAULT_APP_SECRET=your_credential_secret

# These reference vault secrets — resolved at startup
# Format: "vault:path/to/secrets#key" (quotes required for the # separator)
DATABASE_HOST="vault:examples/database#host"
DATABASE_PORT="vault:examples/database#port"
DATABASE_USER="vault:examples/database#user"
DATABASE_PASSWORD="vault:examples/database#password"
DATABASE_NAME="vault:examples/database#database"
SECRET_STRING="vault:examples/app#secret_string"
